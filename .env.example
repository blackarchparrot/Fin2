# OpenRouter API Key (Server-side only, NEVER use VITE_ prefix)
# Get a free API key at https://openrouter.ai/keys
# The app functions seamlessly in Demo Mode even without an API key!
OPENROUTER_API_KEY="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"

# Configurable OpenRouter model identifier
# Default is the zero-cost free model router: "openrouter/free"
# Other free options include:
# - "meta-llama/llama-3.3-70b-instruct:free"
# - "google/gemini-2.0-flash-lite-preview-02-05:free"
# - "mistralai/mistral-small-3.1-24b-instruct:free"
OPENROUTER_MODEL="openrouter/free"

# Deployment app URL
APP_URL="http://localhost:3000"

